# Copy this file to .env and fill in the values you have.
# Only ANTHROPIC_API_KEY is required.

# REQUIRED
ANTHROPIC_API_KEY=sk-ant-...

# OPTIONAL — outbound email (Gmail App Password, not your login password)
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
EMAIL_TO=you@gmail.com

# OPTIONAL — Slack summary post
SLACK_BOT_TOKEN=xoxb-...
SLACK_CHANNEL=#scout

# OPTIONAL — raises GitHub API rate limit from 60 to 5000 req/hour
GITHUB_TOKEN=ghp_...
